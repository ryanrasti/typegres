{
  "name": "typegres-oracle-notes-example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,vite \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/dev.ts",
    "build": "vite build && tsdown --config tsdown.config.ts",
    "start": "node dist-server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "oracledb": "^6.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typegres": "file:../..",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "tsdown": "^0.22.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "unplugin-swc": "^1.5.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
